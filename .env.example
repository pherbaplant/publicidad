# Base de datos Postgres (Neon o Supabase, capa gratuita).
#
# DATABASE_URL: conexión POOLED — la usa la app en runtime (server actions,
#   route handlers). En Neon es la que trae "-pooler" en el host; en Supabase
#   es la del puerto 6543 (modo "Transaction").
# DIRECT_URL: conexión DIRECTA (sin pooler) — la usa el CLI de Prisma para
#   migraciones (prisma migrate deploy/dev). En Neon es la URL sin "-pooler";
#   en Supabase es la del puerto 5432 (modo "Session").
DATABASE_URL="postgresql://user:password@host-pooler.region.provider.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.provider.tech/dbname?sslmode=require"

# Vercel Blob — almacenamiento de evidencia fotográfica en producción (el
# filesystem de Vercel es efímero, no sirve para persistir fotos). Se obtiene
# creando un Blob Store en el dashboard de Vercel (Storage → Create → Blob);
# Vercel inyecta esta variable automáticamente si el store está conectado al
# proyecto. Déjala vacía en desarrollo local: sin ella, las fotos se guardan
# en el disco local (ver UPLOADS_DIR) y se sirven vía /api/uploads/[filename].
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Solo para desarrollo local sin Vercel Blob: carpeta donde se guardan las
# fotos de evidencia. Por defecto usa ./uploads dentro del repo.
# UPLOADS_DIR="./uploads"
