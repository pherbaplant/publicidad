# Desarrollo local (SQLite dentro del repo, ya en .gitignore).
DATABASE_URL="file:./dev.db"

# En producción (Railway, Render, cualquier host con disco persistente):
# apunta ambas variables a rutas DENTRO del volumen persistente que montes,
# no a rutas relativas del proyecto — el resto del filesystem del contenedor
# no sobrevive a un redeploy.
#
# DATABASE_URL="file:/data/prod.db"
# UPLOADS_DIR="/data/uploads"
